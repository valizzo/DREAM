    "feature_definitions": {
      "n_imp_neutral_norm": "Smoothed neutral.0 neon density / initial_ne_max; absent neon neutral is zero.",
      "Ne_ion_norm": "Smoothed sum of ion densities with labels starting Ne / initial_ne_max (not charge weighted).",
      "te_rel_to_initial": "Smoothed electron temperature / max(abs(smoothed initial electron temperature)).",
      "psi_norm": "Smoothed poloidal flux / max(abs(smoothed initial poloidal flux)); preserve flux convention.",
      "abs_q": "Absolute, unsmoothed safety factor.",
      "prox_q1": "exp(-0.5*(distance in rho to nearest abs(q)=1 surface / 0.15)^2); zero if absent.",
      "present_q2": "-1 inside nearest abs(q)=2 surface, +1 at/outside it, zero if absent.",
      "grad_p": "Gradient of smoothed pressure w.r.t. rho / max(initial pressure); axis gradient zero; clip [-5,5].",
      "wth_norm": "Thermal energy / initial thermal energy, broadcast across rho.",
      "dwth_norm_dt_scaled": "Backward difference of wth_norm in seconds * thermal_quench_time * 100; first sample forward difference.",
      "ip_norm": "Signed plasma current / initial plasma current, broadcast across rho.",
      "dip_norm_dt_scaled": "Backward difference of ip_norm in seconds * thermal_quench_time * 100; first sample forward difference.",
      "li": "2*q_safe(rho)^2/rho^4 * integral_0^rho(s^3/q_safe(s)^2 ds), trapezoidal; axis 0.5; abs(q)<=1e-6 replaced by +1e-6.",
      "j_tor_norm": "Smoothed toroidal current density / signed largest-absolute value of smoothed initial profile."
    },
    "feature_units": "All engineered features are dimensionless.",
    "window_size": 12,
    "time_step_seconds": 5e-06,
    "forecast_horizon_samples": 1,
    "gru_history": "Reset hidden state for each complete sliding window.",
    "input_layout": "batch,time,rho,feature",
    "output_layout": "batch,rho",
    "target": "core_profiles.profiles_1d.electrons.particles.d",
    "target_units": "m^2/s",
    "target_training_log10_bounds": [
      -2.0,
      5.0
    ],
    "imputer": {
      "strategy": "median",
      "missing_values": "NaN"
    },
    "preprocessing_order": [
      "engineer native profiles",
      "resample time",
      "interpolate to model rho grid",
      "select features",
      "impute NaNs",
      "standardize",
      "infer",
      "denormalize log10(D)",
      "clip to training range",
      "10**log10(D)"
    ],
    "profile_contract": {
      "coordinate": "rho_pol_norm = sqrt(normalized poloidal flux), not DREAM radius in meters",
      "radial_interpolation": "numpy.interp; linear with constant endpoint extension",
      "edge": "Drop last native point from radial profiles when initial rho[-1] is 1 within 1e-8.",
      "smoothing": "5-point boxcar with reflect padding; restore original first value; no smoothing for fewer than 5 points.",
      "initial_ne_max": "Peak of unsmoothed FULL initial charge-weighted ion sum, including excluded edge.",
      "electron_density": "Sum z_ion*n_ion; fallback charges parsed from D/T/H/Ne labels; nonfinite densities replaced by zero.",
      "pressure": "(ne*Te + ion.0.density*ion.0.temperature)*1.602176634e-19, temperatures in eV; initial pressure uses smoothed initial densities/temperatures then is smoothed again.",
      "thermal_energy": "summary.global_quantities.energy_thermal.value; fallback initial 1.5*integral(initial pressure d rho).",
      "summary_interpolation": "Linear interpolation in seconds onto native profile times, constant endpoint extension.",
      "thermal_quench_time": "1e-3*a/q95 seconds; q95 from initial abs(q) at rho=sqrt(0.95), default 4; a meters: D3D .67, SPARC .57, JET 1, ITER 2, KSTAR .5, unknown 1.",
      "q_surfaces": "Find exact abs(q) integers within 1e-10 and linearly interpolate crossings in rho; nearest-surface flags include multiple crossings.",
      "initial_baselines": "Recompute from EACH simulation's initial state; these are distinct from saved training-set standardization statistics.",
      "temporal_resampling": "Offline PCHIP per finite feature column with constant endpoint extension; one finite value held constant; all missing stays NaN.",
      "causality_warning": "Offline PCHIP and first-sample forward derivatives may use future data. Online causal sampling/startup must be resolved before DREAM deployment."
    },
